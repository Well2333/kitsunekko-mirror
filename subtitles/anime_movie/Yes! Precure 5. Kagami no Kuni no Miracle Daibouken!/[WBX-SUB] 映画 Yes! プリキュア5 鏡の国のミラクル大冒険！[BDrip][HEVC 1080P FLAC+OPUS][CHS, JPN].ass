Dialogue: 0,0:08:22.18,0:08:24.77,Default JP,,0,0,0,,ご覧になって  お姉様
Dialogue: 0,0:08:22.18,0:08:24.77,Default CN,,0,0,0,,姐姐大人 您请看
Dialogue: 0,0:08:26.56,0:08:29.48,Default JP,,0,0,0,,今朝  ピンキーを  キャッチしましたの
Dialogue: 0,0:08:26.56,0:08:29.48,Default CN,,0,0,0,,今天早上 我抓到精灵了呢
Dialogue: 0,0:08:29.86,0:08:33.11,Default JP,,0,0,0,,まあ  かわいらしい  ピンキーですこと
Dialogue: 0,0:08:29.86,0:08:33.11,Default CN,,0,0,0,,哎呀 这精灵真可爱
Dialogue: 0,0:08:33.53,0:08:35.62,Default JP,,0,0,0,,そんな  お姉さま...
Dialogue: 0,0:08:33.53,0:08:35.62,Default CN,,0,0,0,,您过奖了 姐姐大人...
Dialogue: 0,0:08:36.37,0:08:37.45,Default JP,,0,0,0,,恥ずかしい
Dialogue: 0,0:08:36.37,0:08:37.45,Default CN,,0,0,0,,愧不敢当呀
Dialogue: 0,0:08:38.12,0:08:40.45,Default JP,,0,0,0,,うらら  お手柄ですわミル
Dialogue: 0,0:08:38.12,0:08:40.45,Default CN,,0,0,0,,丽 你做得很好
Dialogue: 0,0:08:40.62,0:08:43.79,Default JP,,0,0,0,,まあ  ミルクさま  光栄ですわ
Dialogue: 0,0:08:40.62,0:08:43.79,Default CN,,0,0,0,,能得到米露大人的赞誉 真是万分荣幸
Dialogue: 0,0:08:44.21,0:08:46.12,Default JP,,0,0,0,,褒美を差し上げてよ
Dialogue: 0,0:08:44.21,0:08:46.12,Default CN,,0,0,0,,既是如此 值得嘉奖
Dialogue: 0,0:08:46.47,0:08:47.82,Default JP,,0,0,0,,オ～ッホホホホ~
Dialogue: 0,0:08:46.47,0:08:47.82,Default CN,,0,0,0,,哦~呵呵呵呵~
Dialogue: 0,0:08:48.46,0:08:50.37,Default JP,,0,0,0,,オ～ッホホホホ~
Dialogue: 0,0:08:48.46,0:08:50.37,Default CN,,0,0,0,,哦~呵呵呵呵~
Dialogue: 0,0:08:51.05,0:08:53.37,Alternate JP,,0,0,0,,オ～ッホホホホ~
Dialogue: 0,0:08:51.05,0:08:53.37,Alternate CN,,0,0,0,,哦~呵呵呵呵~
Dialogue: 0,0:08:51.05,0:08:53.37,Default JP,,0,0,0,,ミルミルミルミル~
Dialogue: 0,0:08:51.05,0:08:53.37,Default CN,,0,0,0,,咪咪咪咪~
Dialogue: 0,0:08:53.76,0:08:56.45,Default JP,,0,0,0,,オ～ッホホホホ~
Dialogue: 0,0:08:53.76,0:08:56.45,Default CN,,0,0,0,,哦~呵呵呵呵~
Dialogue: 0,0:08:53.76,0:08:56.45,Alternate JP,,0,0,0,,ミルミルミルミル~
Dialogue: 0,0:08:53.76,0:08:56.45,Alternate CN,,0,0,0,,咪咪咪咪~
Dialogue: 0,0:08:56.97,0:08:58.97,Default JP,,0,0,0,,オ～ッホホホホ~
Dialogue: 0,0:08:56.97,0:08:58.97,Default CN,,0,0,0,,哦~呵呵呵呵~
Dialogue: 0,0:08:56.97,0:08:58.97,Alternate JP,,0,0,0,,ミルミルミルミル~
Dialogue: 0,0:08:56.97,0:08:58.97,Alternate CN,,0,0,0,,咪咪咪咪~
Dialogue: 0,0:08:59.31,0:09:01.07,Default JP,,0,0,0,,...みんな  何やってんの？
Dialogue: 0,0:08:59.31,0:09:01.07,Default CN,,0,0,0,,...你们是要唱戏啊？
Dialogue: 0,0:09:01.14,0:09:01.81,Default JP,,0,0,0,,あっ...
Dialogue: 0,0:09:01.14,0:09:01.81,Default CN,,0,0,0,,呃...
Dialogue: 0,0:09:02.02,0:09:03.56,Default JP,,0,0,0,,お姫様ごっこです
Dialogue: 0,0:09:02.02,0:09:03.56,Default CN,,0,0,0,,我们在扮公主啊
Dialogue: 0,0:09:03.73,0:09:07.30,Default JP,,0,0,0,,せっかく  こんな格好したんだし  成りきって会話しようって
Dialogue: 0,0:09:03.73,0:09:07.30,Default CN,,0,0,0,,难得有机会打扮成这样 就想模仿一下对话嘛
Dialogue: 0,0:09:07.73,0:09:10.65,Default JP,,0,0,0,,お姫様って  こんな感じかしら？
Dialogue: 0,0:09:07.73,0:09:10.65,Default CN,,0,0,0,,所谓公主 应该就是这种感觉吧？
Dialogue: 0,0:09:10.90,0:09:13.35,Default JP,,0,0,0,,かれんさんは  お姫様っていうより...
Dialogue: 0,0:09:10.90,0:09:13.35,Default CN,,0,0,0,,香恋啊 与其说你像公主 倒不如说...
Dialogue: 0,0:09:14.52,0:09:15.35,Default JP,,0,0,0,,女王様？
Dialogue: 0,0:09:14.52,0:09:15.35,Default CN,,0,0,0,,是像女王吧？
Dialogue: 0,0:09:15.95,0:09:16.45,Default JP,,0,0,0,,りん！
Dialogue: 0,0:09:15.95,0:09:16.45,Default CN,,0,0,0,,玲！
Dialogue: 0,0:09:16.53,0:09:17.45,Default JP,,0,0,0,,ウハハハハ
Dialogue: 0,0:09:16.53,0:09:17.45,Default CN,,0,0,0,,哈哈哈哈
Dialogue: 0,0:09:17.53,0:09:18.74,Default JP,,0,0,0,,もう  お待ちなさい！
Dialogue: 0,0:09:17.53,0:09:18.74,Default CN,,0,0,0,,给我站住！
Dialogue: 0,0:09:18.74,0:09:20.16,Default JP,,0,0,0,,イヤ～ですよ
Dialogue: 0,0:09:18.74,0:09:20.16,Default CN,,0,0,0,,不站~
Dialogue: 0,0:09:20.33,0:09:22.02,Default JP,,0,0,0,,りんさん  のぞみさんは？
Dialogue: 0,0:09:20.33,0:09:22.02,Default CN,,0,0,0,,玲 望去哪里了？
Dialogue: 0,0:09:22.75,0:09:24.04,Default JP,,0,0,0,,ああ  のぞみ？
Dialogue: 0,0:09:22.75,0:09:24.04,Default CN,,0,0,0,,啊 你说望啊？
Dialogue: 0,0:09:24.08,0:09:24.52,Default JP,,0,0,0,,わっ！
Dialogue: 0,0:09:24.08,0:09:24.52,Default CN,,0,0,0,,哇！
Dialogue: 0,0:09:25.58,0:09:26.75,Default JP,,0,0,0,,ビックリした...
Dialogue: 0,0:09:25.58,0:09:26.75,Default CN,,0,0,0,,吓我一跳...
Dialogue: 0,0:09:26.83,0:09:29.17,Default JP,,0,0,0,,やった  大成功！
Dialogue: 0,0:09:26.83,0:09:29.17,Default CN,,0,0,0,,很好 整蛊成功！
Dialogue: 0,0:09:29.34,0:09:30.80,Default JP,,0,0,0,,...こら  のぞみ！
Dialogue: 0,0:09:29.34,0:09:30.80,Default CN,,0,0,0,,...望！
Dialogue: 0,0:09:31.42,0:09:32.25,Default JP,,0,0,0,,もう！
Dialogue: 0,0:09:31.42,0:09:32.25,Default CN,,0,0,0,,真是的！
Dialogue: 0,0:09:38.77,0:09:40.57,Default JP,,0,0,0,,逃がさなくてよ  のぞあ
Dialogue: 0,0:09:38.77,0:09:40.57,Default CN,,0,0,0,,别想跑 望——
Dialogue: 0,0:09:43.12,0:09:43.60,Default JP,,0,0,0,,おっ？
Dialogue: 0,0:09:43.12,0:09:43.60,Default CN,,0,0,0,,嗯？
Dialogue: 0,0:09:43.68,0:09:45.32,Alternate JP,,0,0,0,,王子よ  王子よ
Dialogue: 0,0:09:43.68,0:09:45.32,Alternate CN,,0,0,0,,是王子啊 王子
Dialogue: 0,0:09:45.45,0:09:47.31,Alternate JP,,0,0,0,,ギャー  プリンスよ
Dialogue: 0,0:09:45.45,0:09:47.31,Alternate CN,,0,0,0,,是Prince呀
Dialogue: 0,0:09:47.31,0:09:48.44,Default JP,,0,0,0,,ああ...
Dialogue: 0,0:09:47.31,0:09:48.44,Default CN,,0,0,0,,啊...
Dialogue: 0,0:09:48.44,0:09:49.52,Default JP,,0,0,0,,うん...
Dialogue: 0,0:09:48.44,0:09:49.52,Default CN,,0,0,0,,唔...
Dialogue: 0,0:09:53.32,0:09:55.65,Default JP,,0,0,0,,ココとナッツ  目立ちまくりですね
Dialogue: 0,0:09:53.32,0:09:55.65,Default CN,,0,0,0,,可可和纳兹 很受人瞩目啊
Dialogue: 0,0:09:55.95,0:09:58.28,Default JP,,0,0,0,,さすが本物の王子様ね
Dialogue: 0,0:09:55.95,0:09:58.28,Default CN,,0,0,0,,不愧是正牌的王子
Dialogue: 0,0:10:01.55,0:10:03.62,Default JP,,0,0,0,,あれが  本当の姿だったなら...
Dialogue: 0,0:10:01.55,0:10:03.62,Default CN,,0,0,0,,要是他们原本就长这样...
Dialogue: 0,0:10:03.95,0:10:08.12,Default JP,,0,0,0,,「ココ」とか「ナツ」とか  言うのに  ならなければ...
Dialogue: 0,0:10:03.95,0:10:08.12,Default CN,,0,0,0,,要是他们不会说完话再加个“coco”或者“nuts”...
Dialogue: 0,0:10:11.29,0:10:12.75,Default JP,,0,0,0,,みんな  お待たせ
Dialogue: 0,0:10:11.29,0:10:12.75,Default CN,,0,0,0,,让你们久等了
Dialogue: 0,0:10:13.67,0:10:15.09,Default JP,,0,0,0,,ありがとう  ナッツさん
Dialogue: 0,0:10:13.67,0:10:15.09,Default CN,,0,0,0,,谢谢你 纳兹
Dialogue: 0,0:10:15.09,0:10:16.83,Default JP,,0,0,0,,あれ？のぞみは？
Dialogue: 0,0:10:15.09,0:10:16.83,Default CN,,0,0,0,,咦？望呢？
Dialogue: 0,0:10:17.76,0:10:20.47,Default JP,,0,0,0,,ああ  のぞみは  ジュース買いに行くって
Dialogue: 0,0:10:17.76,0:10:20.47,Default CN,,0,0,0,,啊 她去买果汁了
Dialogue: 0,0:10:21.05,0:10:23.17,Default JP,,0,0,0,,じゃ  どこかで  行き違ったのかもな
Dialogue: 0,0:10:21.05,0:10:23.17,Default CN,,0,0,0,,那我可能是跟她错过了吧
Dialogue: 0,0:10:26.18,0:10:26.60,Default JP,,0,0,0,,わっ！
Dialogue: 0,0:10:26.18,0:10:26.60,Default CN,,0,0,0,,哇！
Dialogue: 0,0:10:26.64,0:10:27.47,Default JP,,0,0,0,,ハッ！ハァッ！
Dialogue: 0,0:10:26.64,0:10:27.47,Default CN,,0,0,0,,哎！哎呀！
Dialogue: 0,0:10:27.69,0:10:28.77,Default JP,,0,0,0,,ハハハハハハッ
Dialogue: 0,0:10:27.69,0:10:28.77,Default CN,,0,0,0,,哈哈哈哈哈
Dialogue: 0,0:10:28.95,0:10:29.80,Default JP,,0,0,0,,残念でした
Dialogue: 0,0:10:28.95,0:10:29.80,Default CN,,0,0,0,,真可惜呀
Dialogue: 0,0:10:30.10,0:10:32.52,Default JP,,0,0,0,,もう！つまんない！
Dialogue: 0,0:10:30.10,0:10:32.52,Default CN,,0,0,0,,你算计我啊！
Dialogue: 0,0:10:32.52,0:10:33.55,Default JP,,0,0,0,,どうして分かったの？
Dialogue: 0,0:10:32.52,0:10:33.55,Default CN,,0,0,0,,为什么你会知道我在哪？
Dialogue: 0,0:10:33.94,0:10:35.32,Default JP,,0,0,0,,どうしてかな？
Dialogue: 0,0:10:33.94,0:10:35.32,Default CN,,0,0,0,,为什么呢？
Dialogue: 0,0:10:42.37,0:10:46.04,Default JP,,0,0,0,,何か感じるんだ  のぞみのこと
Dialogue: 0,0:10:42.37,0:10:46.04,Default CN,,0,0,0,,就是 感觉到了你嘛
Dialogue: 0,0:10:47.95,0:10:49.12,Default JP,,0,0,0,,変なの
Dialogue: 0,0:10:47.95,0:10:49.12,Default CN,,0,0,0,,哪有这么巧的
Dialogue: 0,0:10:51.88,0:10:54.20,Default JP,,0,0,0,,のぞみ姫  参りましょうか
Dialogue: 0,0:10:51.88,0:10:54.20,Default CN,,0,0,0,,望公主 我们出发吧
Dialogue: 0,0:10:56.10,0:10:56.84,Default JP,,0,0,0,,はい！
Dialogue: 0,0:10:56.10,0:10:56.84,Default CN,,0,0,0,,好啊！
Dialogue: 0,0:11:11.94,0:11:14.11,Default JP,,0,0,0,,のぞみは  幸せそうに食べるね
Dialogue: 0,0:11:11.94,0:11:14.11,Default CN,,0,0,0,,你的吃相看起来很幸福呀
Dialogue: 0,0:11:14.27,0:11:16.15,Default JP,,0,0,0,,うん  幸せ！
Dialogue: 0,0:11:14.27,0:11:16.15,Default CN,,0,0,0,,是啊 很幸福呢！
Dialogue: 0,0:11:16.77,0:11:18.99,Default JP,,0,0,0,,はい  幸せのお裾分け
Dialogue: 0,0:11:16.77,0:11:18.99,Default CN,,0,0,0,,喏 也分你一点幸福
Dialogue: 0,0:11:19.55,0:11:20.91,Default JP,,0,0,0,,じゃ  遠慮なく
Dialogue: 0,0:11:19.55,0:11:20.91,Default CN,,0,0,0,,那 我就不客气了
Dialogue: 0,0:11:21.74,0:11:24.87,Default JP,,0,0,0,,ミルクも  ココ様と  ご一緒するミル
Dialogue: 0,0:11:21.74,0:11:24.87,Default CN,,0,0,0,,我也要跟可可大人一起——
Dialogue: 0,0:11:25.58,0:11:27.54,Default JP,,0,0,0,,ミルク  騒いじゃダメよ
Dialogue: 0,0:11:25.58,0:11:27.54,Default CN,,0,0,0,,米露 安静点
Dialogue: 0,0:11:27.83,0:11:29.25,Default JP,,0,0,0,,これ  うんまい
Dialogue: 0,0:11:27.83,0:11:29.25,Default CN,,0,0,0,,这个很好吃啊
Dialogue: 0,0:11:29.58,0:11:31.52,Default JP,,0,0,0,,りんさん  これもイケますよ
Dialogue: 0,0:11:29.58,0:11:31.52,Default CN,,0,0,0,,玲 这个也很不错呢
Dialogue: 0,0:11:31.75,0:11:32.58,Default JP,,0,0,0,,ああっ！
Dialogue: 0,0:11:31.75,0:11:32.58,Default CN,,0,0,0,,啊！
Dialogue: 0,0:11:33.29,0:11:34.88,Default JP,,0,0,0,,こまち  どうした？
Dialogue: 0,0:11:33.29,0:11:34.88,Default CN,,0,0,0,,怎么了 小町？
Dialogue: 0,0:11:35.50,0:11:37.59,Default JP,,0,0,0,,こういう靴  慣れなくて...
Dialogue: 0,0:11:35.50,0:11:37.59,Default CN,,0,0,0,,我不太习惯穿这种鞋子...
Dialogue: 0,0:11:38.55,0:11:40.55,Default JP,,0,0,0,,あ...あの...
Dialogue: 0,0:11:38.55,0:11:40.55,Default CN,,0,0,0,,呃...我...
Dialogue: 0,0:11:40.72,0:11:43.34,Default JP,,0,0,0,,支えがあれば  少しは歩きやすいだろう
Dialogue: 0,0:11:40.72,0:11:43.34,Default CN,,0,0,0,,我扶你吧 这样会好走一些
Dialogue: 0,0:11:43.80,0:11:44.77,Default JP,,0,0,0,,ええ...
Dialogue: 0,0:11:43.80,0:11:44.77,Default CN,,0,0,0,,嗯...
Dialogue: 0,0:11:52.06,0:11:54.27,Default JP,,0,0,0,,ああ  広～い
Dialogue: 0,0:11:52.06,0:11:54.27,Default CN,,0,0,0,,哇 好大哦~
Dialogue: 0,0:11:55.85,0:11:57.57,Default JP,,0,0,0,,本格的ですね
Dialogue: 0,0:11:55.85,0:11:57.57,Default CN,,0,0,0,,做得很逼真呀
Dialogue: 0,0:11:58.94,0:12:00.99,Default JP,,0,0,0,,うわ  伸びてる！
Dialogue: 0,0:11:58.94,0:12:00.99,Default CN,,0,0,0,,哦 我变长了！
Dialogue: 0,0:12:01.03,0:12:02.35,Default JP,,0,0,0,,ハハッ  ホントだ
Dialogue: 0,0:12:01.03,0:12:02.35,Default CN,,0,0,0,,哈哈 真的呢
Dialogue: 0,0:12:04.24,0:12:06.78,Default JP,,0,0,0,,ンン...横長に見える鏡か
Dialogue: 0,0:12:04.24,0:12:06.78,Default CN,,0,0,0,,唔...是会让人变扁的镜子啊
Dialogue: 0,0:12:06.95,0:12:07.47,Default JP,,0,0,0,,ウッ
Dialogue: 0,0:12:06.95,0:12:07.47,Default CN,,0,0,0,,呃
Dialogue: 0,0:12:07.49,0:12:08.79,Default JP,,0,0,0,,ちょっと
Dialogue: 0,0:12:07.49,0:12:08.79,Default CN,,0,0,0,,不要照了
Dialogue: 0,0:12:09.45,0:12:10.42,Default JP,,0,0,0,,ふ～
Dialogue: 0,0:12:09.45,0:12:10.42,Default CN,,0,0,0,,芜湖～
Comment: 0,0:12:09.45,0:12:10.42,Default CN,,0,0,0,,嗯～
Dialogue: 0,0:12:10.54,0:12:11.58,Default JP,,0,0,0,,うん？
Dialogue: 0,0:12:10.54,0:12:11.58,Default CN,,0,0,0,,嗯？
Dialogue: 0,0:12:11.75,0:12:14.54,Default JP,,0,0,0,,横長のナッツさんは  見たくないの
Dialogue: 0,0:12:11.75,0:12:14.54,Default CN,,0,0,0,,我不想看到变扁的纳兹
Dialogue: 0,0:12:17.97,0:12:20.46,Default JP,,0,0,0,,ミルクにそっくりな子が  たくさん  いるミル
Dialogue: 0,0:12:17.97,0:12:20.46,Default CN,,0,0,0,,镜子里有很多长得很像我的人
Dialogue: 0,0:12:20.76,0:12:22.59,Default JP,,0,0,0,,これは  「合わせ鏡」よ
Dialogue: 0,0:12:20.76,0:12:22.59,Default CN,,0,0,0,,这叫“合镜”
Dialogue: 0,0:12:22.76,0:12:27.01,Default JP,,0,0,0,,鏡を2枚  合わせると  自分が  何人もいるように見えるの
Dialogue: 0,0:12:22.76,0:12:27.01,Default CN,,0,0,0,,只要把两面镜子组合起来 就能看见很多个自己了
Dialogue: 0,0:12:28.97,0:12:30.73,Default JP,,0,0,0,,そっくりな子じゃないミル？
Dialogue: 0,0:12:28.97,0:12:30.73,Default CN,,0,0,0,,不是长得像我的人啊？
Dialogue: 0,0:12:31.10,0:12:32.52,Default JP,,0,0,0,,全部ミルクよ
Dialogue: 0,0:12:31.10,0:12:32.52,Default CN,,0,0,0,,全都是你自己啦
Dialogue: 0,0:12:34.73,0:12:38.23,Default JP,,0,0,0,,合わせ鏡には  面白い話があるのよ
Dialogue: 0,0:12:34.73,0:12:38.23,Default CN,,0,0,0,,关于合镜 有个有趣的故事哦
Dialogue: 0,0:12:38.44,0:12:39.98,Default JP,,0,0,0,,何ミル？
Dialogue: 0,0:12:38.44,0:12:39.98,Default CN,,0,0,0,,什么故事？
Dialogue: 0,0:12:40.32,0:12:43.32,Default JP,,0,0,0,,真夜中の2時に  合わせ鏡をすると
Dialogue: 0,0:12:40.32,0:12:43.32,Default CN,,0,0,0,,据说 如果在半夜2点时去照了合镜
Dialogue: 0,0:12:43.65,0:12:45.41,Default JP,,0,0,0,,恐ろしいことが  起きるの
Dialogue: 0,0:12:43.65,0:12:45.41,Default CN,,0,0,0,,将会发生很恐怖的事情
Dialogue: 0,0:12:45.91,0:12:46.49,Default JP,,0,0,0,,えっ...
Dialogue: 0,0:12:45.91,0:12:46.49,Default CN,,0,0,0,,呃...
Dialogue: 0,0:12:46.49,0:12:48.03,Default JP,,0,0,0,,恐ろしい...こと...
Dialogue: 0,0:12:46.49,0:12:48.03,Default CN,,0,0,0,,很恐怖的...事情...
Dialogue: 0,0:12:48.33,0:12:49.15,Default JP,,0,0,0,,そう
Dialogue: 0,0:12:48.33,0:12:49.15,Default CN,,0,0,0,,没错
Dialogue: 0,0:12:50.25,0:12:52.37,Default JP,,0,0,0,,もうひとりの自分の話よ
Dialogue: 0,0:12:50.25,0:12:52.37,Default CN,,0,0,0,,是关于另一个自己的事
Dialogue: 0,0:12:53.65,0:12:55.71,Default JP,,0,0,0,,もうひとりの...自分？
Dialogue: 0,0:12:53.65,0:12:55.71,Default CN,,0,0,0,,另一个...自己？
Dialogue: 0,0:12:55.87,0:13:00.13,Default JP,,0,0,0,,危険なのは  手前から数えて  9番目の自分よ
Dialogue: 0,0:12:55.87,0:13:00.13,Default CN,,0,0,0,,从眼前数起的那第九个自己 就是危险所在
Dialogue: 0,0:13:00.80,0:13:06.55,Default JP,,0,0,0,,本物に成り代わろうと  鏡の中から  ヌーッと出てきて
Dialogue: 0,0:13:00.80,0:13:06.55,Default CN,,0,0,0,,为了顶替本尊 它会从镜子里突然冒出来——
Comment: 0,0:13:06.76,0:13:08.72,Default JP,,0,0,0,,あああああああ！！！
Dialogue: 0,0:13:08.97,0:13:10.35,Default JP,,0,0,0,,り...りんちゃん...？
Dialogue: 0,0:13:08.97,0:13:10.35,Default CN,,0,0,0,,玲...？
Dialogue: 0,0:13:11.10,0:13:14.85,Default JP,,0,0,0,,や  やめてくださいよ  こまちさん  怖いじゃないですか...
Dialogue: 0,0:13:11.10,0:13:14.85,Default CN,,0,0,0,,不 不要再说了 小町 太吓人了...
Dialogue: 0,0:13:14.98,0:13:17.60,Default JP,,0,0,0,,いや...りんの悲鳴のほうが  怖いわよ
Dialogue: 0,0:13:14.98,0:13:17.60,Default CN,,0,0,0,,不是...你的惨叫更吓人啊
Dialogue: 0,0:13:17.98,0:13:21.36,Default JP,,0,0,0,,鏡の話なら  私も聞いたことありますよ
Dialogue: 0,0:13:17.98,0:13:21.36,Default CN,,0,0,0,,我也听过关于镜子的故事呢
Dialogue: 0,0:13:21.73,0:13:24.85,Default JP,,0,0,0,,鏡の向こうには  もうひとつの世界があるって
Dialogue: 0,0:13:21.73,0:13:24.85,Default CN,,0,0,0,,在镜子的另一边 还存在着另一个世界——之类的
Dialogue: 0,0:13:25.11,0:13:27.78,Default JP,,0,0,0,,へえ...もうひとつの世界か
Dialogue: 0,0:13:25.11,0:13:27.78,Default CN,,0,0,0,,欸...另一个世界啊
Dialogue: 0,0:13:28.57,0:13:31.37,Default JP,,0,0,0,,おい~鏡の世界の皆さん
Dialogue: 0,0:13:28.57,0:13:31.37,Default CN,,0,0,0,,喂~镜中世界的各位
Dialogue: 0,0:13:31.42,0:13:32.97,Default JP,,0,0,0,,聞こえますか？
Dialogue: 0,0:13:31.42,0:13:32.97,Default CN,,0,0,0,,你们听得见吗？
Dialogue: 0,0:13:34.08,0:13:35.75,Default JP,,0,0,0,,のぞみさん  行きますよ
Dialogue: 0,0:13:34.08,0:13:35.75,Default CN,,0,0,0,,望 该走了
Dialogue: 0,0:13:35.75,0:13:36.37,Default JP,,0,0,0,,うん？
Dialogue: 0,0:13:35.75,0:13:36.37,Default CN,,0,0,0,,嗯？
Dialogue: 0,0:13:36.92,0:13:38.22,Default JP,,0,0,0,,ああ  待って
Dialogue: 0,0:13:36.92,0:13:38.22,Default CN,,0,0,0,,啊 等等我——
Dialogue: 0,0:13:46.10,0:13:48.09,Default JP,,0,0,0,,鏡の迷路もあるのね
Dialogue: 0,0:13:46.10,0:13:48.09,Default CN,,0,0,0,,还有用镜子做的迷宫啊
Dialogue: 0,0:13:48.32,0:13:49.80,Default JP,,0,0,0,,面白い！
Dialogue: 0,0:13:48.32,0:13:49.80,Default CN,,0,0,0,,真好玩！
Dialogue: 0,0:13:51.31,0:13:53.20,Default JP,,0,0,0,,のぞみ  気をつけないと危ないよ
Dialogue: 0,0:13:51.31,0:13:53.20,Default CN,,0,0,0,,望 小心一点 注意安全呀
Dialogue: 0,0:13:53.39,0:13:54.30,Default JP,,0,0,0,,ええっ？
Dialogue: 0,0:13:53.39,0:13:54.30,Default CN,,0,0,0,,什么？
Dialogue: 0,0:13:54.30,0:13:55.77,Default JP,,0,0,0,,あ  いてっ...
Dialogue: 0,0:13:54.30,0:13:55.77,Default CN,,0,0,0,,呃 好痛...
Dialogue: 0,0:13:59.92,0:14:01.69,Default JP,,0,0,0,,ここは行き止まりだな
Dialogue: 0,0:13:59.92,0:14:01.69,Default CN,,0,0,0,,这里是死路啊
Dialogue: 0,0:14:04.37,0:14:04.95,Default JP,,0,0,0,,うん？
Dialogue: 0,0:14:04.37,0:14:04.95,Default CN,,0,0,0,,唔？
Dialogue: 0,0:14:07.40,0:14:09.11,Default JP,,0,0,0,,さっきの本当？
Dialogue: 0,0:14:07.40,0:14:09.11,Default CN,,0,0,0,,你刚才说的 是真话吗？
Dialogue: 0,0:14:09.45,0:14:10.02,Default JP,,0,0,0,,うん？
Dialogue: 0,0:14:09.45,0:14:10.02,Default CN,,0,0,0,,啊？
Dialogue: 0,0:14:11.66,0:14:13.83,Default JP,,0,0,0,,私のこと  感じるって...
Dialogue: 0,0:14:11.66,0:14:13.83,Default CN,,0,0,0,,你说 你能感觉到我...
Dialogue: 0,0:14:15.41,0:14:16.71,Default JP,,0,0,0,,本当だよ
Dialogue: 0,0:14:15.41,0:14:16.71,Default CN,,0,0,0,,是真的
Dialogue: 0,0:14:17.50,0:14:20.33,Default JP,,0,0,0,,だから  どこへ行っても  どこに隠れたってムダだよ
Dialogue: 0,0:14:17.50,0:14:20.33,Default CN,,0,0,0,,所以 不管你去了哪里 躲到哪里 都瞒不过我
Dialogue: 0,0:14:20.50,0:14:21.84,Default JP,,0,0,0,,見つけちゃうから
Dialogue: 0,0:14:20.50,0:14:21.84,Default CN,,0,0,0,,我都会找到你的
Dialogue: 0,0:14:23.70,0:14:26.42,Default JP,,0,0,0,,ええっ？本当かな？
Dialogue: 0,0:14:23.70,0:14:26.42,Default CN,,0,0,0,,欸？真的假的？
Dialogue: 0,0:14:26.90,0:14:27.80,Default JP,,0,0,0,,のぞみは？
Dialogue: 0,0:14:26.90,0:14:27.80,Default CN,,0,0,0,,你呢？
Dialogue: 0,0:14:28.04,0:14:28.44,Default JP,,0,0,0,,うん？
Dialogue: 0,0:14:28.04,0:14:28.44,Default CN,,0,0,0,,我？
Dialogue: 0,0:14:29.09,0:14:33.18,Default JP,,0,0,0,,僕が違う姿になったり  どこかにいなくなったりしても
Dialogue: 0,0:14:29.09,0:14:33.18,Default CN,,0,0,0,,即使我改变了容貌 或是藏到了某个地方
Dialogue: 0,0:14:33.51,0:14:34.89,Default JP,,0,0,0,,見つけてくれる？
Dialogue: 0,0:14:33.51,0:14:34.89,Default CN,,0,0,0,,你也能找到我吗？
Dialogue: 0,0:14:38.72,0:14:39.72,Default JP,,0,0,0,,見つけるよ！
Dialogue: 0,0:14:38.72,0:14:39.72,Default CN,,0,0,0,,可以啊！
Dialogue: 0,0:14:39.98,0:14:43.32,Default JP,,0,0,0,,ココが  どんな姿になっても  どこにいても！
Dialogue: 0,0:14:39.98,0:14:43.32,Default CN,,0,0,0,,不管你变成什么样子 去了哪里 我都可以找到你！
Dialogue: 0,0:14:45.27,0:14:46.30,Default JP,,0,0,0,,本当かな？
Dialogue: 0,0:14:45.27,0:14:46.30,Default CN,,0,0,0,,真的吗？
Dialogue: 0,0:14:48.50,0:14:50.03,Default JP,,0,0,0,,もう  本当だよ！
Dialogue: 0,0:14:48.50,0:14:50.03,Default CN,,0,0,0,,当然是真的啊！
Dialogue: 0,0:14:56.04,0:14:56.62,Default JP,,0,0,0,,いたっ！
Dialogue: 0,0:14:56.04,0:14:56.62,Default CN,,0,0,0,,痛！
Dialogue: 0,0:15:01.21,0:15:04.60,Default JP,,0,0,0,,こっちの世界には  面白いものが  たくさんあるな
Dialogue: 0,0:15:01.21,0:15:04.60,Default CN,,0,0,0,,这个世界里 有很多有趣的东西呢
Dialogue: 0,0:15:04.92,0:15:07.59,Default JP,,0,0,0,,そうか？単なる暇潰しだろう
Dialogue: 0,0:15:04.92,0:15:07.59,Default CN,,0,0,0,,是吗？我看也就是为了打发时间才做出来的
Dialogue: 0,0:15:07.97,0:15:10.30,Default JP,,0,0,0,,ナッツは  苦手だろう？こういうの
Dialogue: 0,0:15:07.97,0:15:10.30,Default CN,,0,0,0,,你不擅长玩这种类型的吧？
Dialogue: 0,0:15:10.88,0:15:12.05,Default JP,,0,0,0,,バカにするな
Dialogue: 0,0:15:10.88,0:15:12.05,Default CN,,0,0,0,,开玩笑
Dialogue: 0,0:15:13.15,0:15:15.56,Default JP,,0,0,0,,この程度の迷路  簡単に出られる
Dialogue: 0,0:15:13.15,0:15:15.56,Default CN,,0,0,0,,就这种迷宫 我三两下就能走出去了
Dialogue: 0,0:15:15.76,0:15:19.23,Default JP,,0,0,0,,じゃ  競争するか？どっちが先にゴールするか
Dialogue: 0,0:15:15.76,0:15:19.23,Default CN,,0,0,0,,那 要不要来比一比 看谁先走到终点？
Dialogue: 0,0:15:19.60,0:15:20.10,Default JP,,0,0,0,,いいだろう
Dialogue: 0,0:15:19.60,0:15:20.10,Default CN,,0,0,0,,行啊
Dialogue: 0,0:15:20.73,0:15:23.77,Default JP,,0,0,0,,俺が勝ったら  豆大福  3日分  おごってもらう
Dialogue: 0,0:15:20.73,0:15:23.77,Default CN,,0,0,0,,要是我赢了 你要给我三天份量的红豆大福
Dialogue: 0,0:15:23.77,0:15:26.48,Default JP,,0,0,0,,負けたら  シュークリーム  3日分だぞ？
Dialogue: 0,0:15:23.77,0:15:26.48,Default CN,,0,0,0,,那你要是输了 可得给我三天份的奶油泡芙啊？
Dialogue: 0,0:15:26.78,0:15:28.15,Default JP,,0,0,0,,姿  覚えた
Dialogue: 0,0:15:26.78,0:15:28.15,Default CN,,0,0,0,,我记住这副样子了
Dialogue: 0,0:15:28.50,0:15:28.94,Default JP,,0,0,0,,うん？
Dialogue: 0,0:15:28.50,0:15:28.94,Default CN,,0,0,0,,嗯？
Dialogue: 0,0:15:29.28,0:15:30.22,Default JP,,0,0,0,,なんだ？
Dialogue: 0,0:15:29.28,0:15:30.22,Default CN,,0,0,0,,怎么了？
Dialogue: 0,0:15:30.49,0:15:31.95,Default JP,,0,0,0,,いや  声が...
Dialogue: 0,0:15:30.49,0:15:31.95,Default CN,,0,0,0,,我好像听到什么...
Dialogue: 0,0:15:32.11,0:15:33.12,Default JP,,0,0,0,,声も...
Dialogue: 0,0:15:32.11,0:15:33.12,Default CN,,0,0,0,,声音也...
Dialogue: 0,0:15:33.16,0:15:33.99,Default JP,,0,0,0,,覚えた
Dialogue: 0,0:15:33.16,0:15:33.99,Default CN,,0,0,0,,记住了
Dialogue: 0,0:15:34.07,0:15:34.82,Default JP,,0,0,0,,うわっ！
Dialogue: 0,0:15:34.07,0:15:34.82,Default CN,,0,0,0,,呃！
Dialogue: 0,0:15:44.50,0:15:45.57,Default JP,,0,0,0,,ゴール！
Dialogue: 0,0:15:44.50,0:15:45.57,Default CN,,0,0,0,,抵达终点！
Dialogue: 0,0:15:46.40,0:15:48.70,Default JP,,0,0,0,,何番？ねえ  私  何番？
Dialogue: 0,0:15:46.40,0:15:48.70,Default CN,,0,0,0,,我是第几？我是第几个走出来的？
Dialogue: 0,0:15:48.84,0:15:50.42,Default JP,,0,0,0,,残念  ビリでした
Dialogue: 0,0:15:48.84,0:15:50.42,Default CN,,0,0,0,,很遗憾 你是包尾
Dialogue: 0,0:15:50.47,0:15:51.34,Default JP,,0,0,0,,ええっ...？
Dialogue: 0,0:15:50.47,0:15:51.34,Default CN,,0,0,0,,欸...？
Dialogue: 0,0:15:51.76,0:15:53.72,Default JP,,0,0,0,,ココさんとナッツさんが  まだよ
Dialogue: 0,0:15:51.76,0:15:53.72,Default CN,,0,0,0,,还差可可和纳兹呢
Dialogue: 0,0:15:56.70,0:15:57.97,Default JP,,0,0,0,,遅い！
Dialogue: 0,0:15:56.70,0:15:57.97,Default CN,,0,0,0,,你好慢哦！
Dialogue: 0,0:15:59.20,0:16:00.64,Default JP,,0,0,0,,待たせたね
Dialogue: 0,0:15:59.20,0:16:00.64,Default CN,,0,0,0,,久等了
Dialogue: 0,0:16:01.31,0:16:02.97,Default JP,,0,0,0,,逃っげろ～！
Dialogue: 0,0:16:01.31,0:16:02.97,Default CN,,0,0,0,,溜啦～！
Dialogue: 0,0:16:04.81,0:16:06.98,Alternate JP,,0,0,0,,待て  待て！
Dialogue: 0,0:16:04.81,0:16:06.98,Alternate CN,,0,0,0,,别跑！
Dialogue: 0,0:16:05.67,0:16:06.98,Default JP,,0,0,0,,捕まえてごらんなさい~
Dialogue: 0,0:16:05.67,0:16:06.98,Default CN,,0,0,0,,来抓我呀~
Dialogue: 0,0:16:09.61,0:16:10.32,Default JP,,0,0,0,,あっ！
Dialogue: 0,0:16:09.61,0:16:10.32,Default CN,,0,0,0,,啊！
Dialogue: 0,0:16:10.99,0:16:12.00,Default JP,,0,0,0,,のぞみさん...？
Dialogue: 0,0:16:10.99,0:16:12.00,Default CN,,0,0,0,,望...？
Dialogue: 0,0:16:12.42,0:16:13.05,Default JP,,0,0,0,,うわ！
Dialogue: 0,0:16:12.42,0:16:13.05,Default CN,,0,0,0,,哎呀！
Dialogue: 0,0:16:13.66,0:16:15.87,Default JP,,0,0,0,,捕まえましたよ  プリンセス
Dialogue: 0,0:16:13.66,0:16:15.87,Default CN,,0,0,0,,抓住您了呢 公主
Dialogue: 0,0:16:18.87,0:16:22.25,Default JP,,0,0,0,,どうして  花畑で  追いかけっこ？意味が分からないわ
Dialogue: 0,0:16:18.87,0:16:22.25,Default CN,,0,0,0,,为什么要在花圃里玩追逐游戏呢？搞不懂
Dialogue: 0,0:16:23.67,0:16:25.64,Default JP,,0,0,0,,楽しいんだから  いいじゃない
Dialogue: 0,0:16:23.67,0:16:25.64,Default CN,,0,0,0,,玩得开心就行了嘛
Dialogue: 0,0:16:26.15,0:16:26.80,Default JP,,0,0,0,,それ！
Dialogue: 0,0:16:26.15,0:16:26.80,Default CN,,0,0,0,,嘿！
Dialogue: 0,0:16:27.12,0:16:28.00,Default JP,,0,0,0,,とりゃ！
Dialogue: 0,0:16:27.12,0:16:28.00,Default CN,,0,0,0,,看我的！
Dialogue: 0,0:16:39.39,0:16:41.89,Default JP,,0,0,0,,こら！諦めるな！
Dialogue: 0,0:16:39.39,0:16:41.89,Default CN,,0,0,0,,喂！不要放弃啊！
Dialogue: 0,0:16:42.27,0:16:44.10,Default JP,,0,0,0,,りんさん  足  速すぎ
Dialogue: 0,0:16:42.27,0:16:44.10,Default CN,,0,0,0,,玲跑得太快了 他们追不上呀
Dialogue: 0,0:16:46.52,0:16:49.94,Alternate JP,,0,0,0,,人気イベント  「お花畑で追いかけっこ」が
Dialogue: 0,0:16:46.52,0:16:49.94,Alternate CN,,0,0,0,,热门娱乐项目“花圃追逐”
Dialogue: 0,0:16:50.11,0:16:53.11,Alternate JP,,0,0,0,,ウォーターパレスにて  開催されております
Dialogue: 0,0:16:50.11,0:16:53.11,Alternate CN,,0,0,0,,正在水之宫举办
Dialogue: 0,0:16:53.75,0:16:54.95,Default JP,,0,0,0,,ココ  ナッツ
Dialogue: 0,0:16:53.75,0:16:54.95,Default CN,,0,0,0,,可可 纳兹
Dialogue: 0,0:16:53.49,0:16:56.07,Alternate JP,,0,0,0,,皆様  ご参加くださいませ...
Dialogue: 0,0:16:53.49,0:16:56.07,Alternate CN,,0,0,0,,请各位游客踊跃参与...
Dialogue: 0,0:16:55.11,0:16:56.82,Default JP,,0,0,0,,りんちゃん  大活躍だよ
Dialogue: 0,0:16:55.11,0:16:56.82,Default CN,,0,0,0,,玲刚才玩得很活跃呢
Dialogue: 0,0:16:58.17,0:16:58.55,Default JP,,0,0,0,,うん？
Dialogue: 0,0:16:58.17,0:16:58.55,Default CN,,0,0,0,,嗯？
Dialogue: 0,0:17:00.04,0:17:00.99,Default JP,,0,0,0,,ねえ  ココ？
Dialogue: 0,0:17:00.04,0:17:00.99,Default CN,,0,0,0,,喂 可可？
Dialogue: 0,0:17:00.99,0:17:01.66,Default JP,,0,0,0,,なに？
Dialogue: 0,0:17:00.99,0:17:01.66,Default CN,,0,0,0,,干嘛？
Dialogue: 0,0:17:02.25,0:17:03.87,Default JP,,0,0,0,,何って...
Dialogue: 0,0:17:02.25,0:17:03.87,Default CN,,0,0,0,,干嘛...
Dialogue: 0,0:17:04.45,0:17:07.77,Default JP,,0,0,0,,えっと...のど  渇いてない？
Dialogue: 0,0:17:04.45,0:17:07.77,Default CN,,0,0,0,,呃...你渴不渴啊？
Dialogue: 0,0:17:08.04,0:17:09.59,Default JP,,0,0,0,,別に
Dialogue: 0,0:17:08.04,0:17:09.59,Default CN,,0,0,0,,不会
Dialogue: 0,0:17:12.05,0:17:15.34,Default JP,,0,0,0,,りんさん  最後まで  捕まらないなんて  凄いわね
Dialogue: 0,0:17:12.05,0:17:15.34,Default CN,,0,0,0,,玲直到最后也没有被抓到过呢 太强了
Dialogue: 0,0:17:15.51,0:17:18.85,Default JP,,0,0,0,,男の人達を引き離して  ましたもんね  ぶっちぎりで
Dialogue: 0,0:17:15.51,0:17:18.85,Default CN,,0,0,0,,把那些男生都甩得远远的
Dialogue: 0,0:17:18.89,0:17:22.68,Default JP,,0,0,0,,ええ...でも  ちょっとは  捕まえて欲しかったかも
Dialogue: 0,0:17:18.89,0:17:22.68,Default CN,,0,0,0,,哎...怎么说呢 我还是有那么一点想被抓住的
Dialogue: 0,0:17:23.35,0:17:26.40,Default JP,,0,0,0,,ナッツ  この花束  ナッツハウスに飾ってよ
Dialogue: 0,0:17:23.35,0:17:26.40,Default CN,,0,0,0,,纳兹 这束花就带回Nuts House里作装饰吧
Dialogue: 0,0:17:26.73,0:17:27.69,Default JP,,0,0,0,,要らない
Dialogue: 0,0:17:26.73,0:17:27.69,Default CN,,0,0,0,,不需要
Dialogue: 0,0:17:27.95,0:17:28.55,Default JP,,0,0,0,,えっ？
Dialogue: 0,0:17:27.95,0:17:28.55,Default CN,,0,0,0,,欸？
Dialogue: 0,0:17:28.65,0:17:32.40,Default JP,,0,0,0,,なんでよ？花を飾ると  お店が華やいで  いいじゃない？
Dialogue: 0,0:17:28.65,0:17:32.40,Default CN,,0,0,0,,为什么？摆点花让店里更好看点 不好吗？
Dialogue: 0,0:17:34.24,0:17:38.16,Default JP,,0,0,0,,そんなことより  ドリームコレットは  大丈夫か？ミルク
Dialogue: 0,0:17:34.24,0:17:38.16,Default CN,,0,0,0,,先不说这个了——梦想圣典还安全吧？米露？
Dialogue: 0,0:17:38.41,0:17:40.41,Default JP,,0,0,0,,はい  ちゃんと持ってますミル
Dialogue: 0,0:17:38.41,0:17:40.41,Default CN,,0,0,0,,嗯 我把它收好了
Dialogue: 0,0:17:41.08,0:17:42.37,Default JP,,0,0,0,,見せてくれ
Dialogue: 0,0:17:41.08,0:17:42.37,Default CN,,0,0,0,,让我看看
Dialogue: 0,0:17:42.77,0:17:43.45,Default JP,,0,0,0,,はいミル
Dialogue: 0,0:17:42.77,0:17:43.45,Default CN,,0,0,0,,好
Dialogue: 0,0:17:54.07,0:17:54.87,Default JP,,0,0,0,,待って！
Dialogue: 0,0:17:54.07,0:17:54.87,Default CN,,0,0,0,,等一下！
Dialogue: 0,0:17:55.34,0:17:56.88,Default JP,,0,0,0,,あなた  誰？！
Dialogue: 0,0:17:55.34,0:17:56.88,Default CN,,0,0,0,,你是谁？！
Dialogue: 0,0:17:58.93,0:18:00.10,Default JP,,0,0,0,,あなたはココじゃない！
Dialogue: 0,0:17:58.93,0:18:00.10,Default CN,,0,0,0,,你不是可可！
Dialogue: 0,0:18:02.60,0:18:04.31,Default JP,,0,0,0,,...何を言いだすんだい？
Dialogue: 0,0:18:02.60,0:18:04.31,Default CN,,0,0,0,,...你说什么呢？
Dialogue: 0,0:18:04.62,0:18:05.77,Default JP,,0,0,0,,ちょっと...のぞみ
Dialogue: 0,0:18:04.62,0:18:05.77,Default CN,,0,0,0,,喂喂...望
Dialogue: 0,0:18:05.98,0:18:08.27,Default JP,,0,0,0,,どっから見ても  ココに見えますけど...
Dialogue: 0,0:18:05.98,0:18:08.27,Default CN,,0,0,0,,这怎么看都是可可本人吧...
Dialogue: 0,0:18:13.44,0:18:17.03,Default JP,,0,0,0,,ココは  私が呼んだら  こっちを向いてくれるの！
Dialogue: 0,0:18:13.44,0:18:17.03,Default CN,,0,0,0,,我叫可可的时候 他都会看着我的！
Dialogue: 0,0:18:17.40,0:18:21.12,Default JP,,0,0,0,,いつも  ちゃんと  まっすぐ  私を  見てくれるの！
Dialogue: 0,0:18:17.40,0:18:21.12,Default CN,,0,0,0,,他总是会好好地注视着我！
Dialogue: 0,0:18:21.42,0:18:22.20,Default JP,,0,0,0,,クッ...
Dialogue: 0,0:18:21.42,0:18:22.20,Default CN,,0,0,0,,呃...
Dialogue: 0,0:18:22.74,0:18:24.45,Default JP,,0,0,0,,あなた達は  誰なの？!
Dialogue: 0,0:18:22.74,0:18:24.45,Default CN,,0,0,0,,你们到底是谁？!
Dialogue: 0,0:18:36.30,0:18:40.01,Default JP,,0,0,0,,フン！よく見抜いたな  褒めてやろう
Dialogue: 0,0:18:36.30,0:18:40.01,Default CN,,0,0,0,,哼！亏你还能看穿啊 真是好眼力
Dialogue: 0,0:18:40.72,0:18:42.22,Default JP,,0,0,0,,ココとナッツは  どこ？！
Dialogue: 0,0:18:40.72,0:18:42.22,Default CN,,0,0,0,,可可和纳兹在哪里？！
Dialogue: 0,0:18:42.47,0:18:45.72,Default JP,,0,0,0,,知りたければ  ドリームコレットを渡せ
Dialogue: 0,0:18:42.47,0:18:45.72,Default CN,,0,0,0,,想知道的话 就把梦想圣典交给我们吧
Dialogue: 0,0:18:46.81,0:18:49.39,Default JP,,0,0,0,,偽物なんかに  渡さないミル！
Dialogue: 0,0:18:46.81,0:18:49.39,Default CN,,0,0,0,,你觉得我们会交给假货吗！
Dialogue: 0,0:18:50.06,0:18:51.40,Default JP,,0,0,0,,ならば...
Dialogue: 0,0:18:50.06,0:18:51.40,Default CN,,0,0,0,,既然如此...
Dialogue: 0,0:18:56.49,0:18:59.49,Default JP,,0,0,0,,これを着ければ  負けないんだな
Dialogue: 0,0:18:56.49,0:18:59.49,Default CN,,0,0,0,,只要戴上这个 就不会输了吧
Dialogue: 0,0:18:59.65,0:19:04.49,Default JP,,0,0,0,,ああ  これを着ければ  プリキュアにも勝てる
Dialogue: 0,0:18:59.65,0:19:04.49,Default CN,,0,0,0,,是啊 只要戴上它 即使是Precure也能胜过
Dialogue: 0,0:19:16.00,0:19:18.88,Monster JP,,0,0,0,,コワイナー
Dialogue: 0,0:19:16.00,0:19:18.88,Monster CN,,0,0,0,,好恐怖哦
Dialogue: 0,0:19:24.18,0:19:26.68,Default JP,,0,0,0,,みんな  いくよ！
Dialogue: 0,0:19:24.18,0:19:26.68,Default CN,,0,0,0,,我们上！
Dialogue: 0,0:19:28.27,0:19:32.35,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&HCB50F4&}Pre{\3c&H5159F4&}cure {\3c&H51E2F4&}Meta{\3c&H99D83A&}mor{\3c&HEF8B36&}phose
Dialogue: 0,0:19:59.13,0:20:01.45,Default JP,,0,0,0,,大いなる希望の力
Dialogue: 0,0:19:59.13,0:20:01.45,Default CN,,0,0,0,,伟大的希望之力
Dialogue: 0,0:20:02.10,0:20:03.72,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&HCB50F4&}Cure Dream
Dialogue: 0,0:20:05.02,0:20:07.32,Default JP,,0,0,0,,情熱の赤い炎
Dialogue: 0,0:20:05.02,0:20:07.32,Default CN,,0,0,0,,热情的红色火焰
Dialogue: 0,0:20:08.67,0:20:10.30,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&H5159F4&}Cure Rouge
Dialogue: 0,0:20:11.39,0:20:13.47,Default JP,,0,0,0,,はじけるレモンの香り
Dialogue: 0,0:20:11.39,0:20:13.47,Default CN,,0,0,0,,迸发的柠檬芬芳
Dialogue: 0,0:20:14.15,0:20:15.85,Default CN,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&H51E2F4&}Cure Lemonade
Dialogue: 0,0:20:17.72,0:20:20.10,Default JP,,0,0,0,,安らぎの緑の大地
Dialogue: 0,0:20:17.72,0:20:20.10,Default CN,,0,0,0,,静谧的绿色大地
Dialogue: 0,0:20:21.22,0:20:23.15,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&H99D83A&}Cure Mint
Dialogue: 0,0:20:24.55,0:20:26.47,Default JP,,0,0,0,,知性の青き泉
Dialogue: 0,0:20:24.55,0:20:26.47,Default CN,,0,0,0,,知性的蓝色清泉
Dialogue: 0,0:20:27.57,0:20:29.40,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&HEF8B36&}Cure Aqua
