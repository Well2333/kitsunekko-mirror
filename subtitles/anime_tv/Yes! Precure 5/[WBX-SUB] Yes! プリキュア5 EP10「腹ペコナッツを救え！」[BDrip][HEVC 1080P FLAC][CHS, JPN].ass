Dialogue: 0,0:17:45.42,0:17:47.22,Default JP,,0,0,0,,知性の青き泉
Dialogue: 0,0:17:45.42,0:17:47.22,Default CN,,0,0,0,,知性的蓝色清泉
Dialogue: 0,0:17:48.24,0:17:49.98,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&HEF8B36&}Cure Aqua
Dialogue: 0,0:17:51.91,0:17:52.96,Default JP,,0,0,0,,希望の力と
Dialogue: 0,0:17:51.91,0:17:52.96,Default CN,,0,0,0,,希望之力
Dialogue: 0,0:17:53.51,0:17:54.82,Default JP,,0,0,0,,未来の光
Dialogue: 0,0:17:53.51,0:17:54.82,Default CN,,0,0,0,,未来之光
Dialogue: 0,0:17:56.02,0:17:58.48,Default JP,,0,0,0,,華麗に羽ばたく5つの心
Dialogue: 0,0:17:56.02,0:17:58.48,Default CN,,0,0,0,,华丽展翅的五颗心
Dialogue: 0,0:18:00.02,0:18:02.24,Default JP,,0,0,0,,Yes！プリキュア5！
Dialogue: 0,0:18:00.02,0:18:02.24,Default CN,,0,0,0,,Yes！Precure5！
Dialogue: 0,0:18:08.54,0:18:09.74,Monster JP,,0,0,0,,コワイナー
Dialogue: 0,0:18:08.54,0:18:09.74,Monster CN,,0,0,0,,好恐怖哦
Dialogue: 0,0:18:11.22,0:18:12.60,Monster JP,,0,0,0,,コワイナー
Dialogue: 0,0:18:11.22,0:18:12.60,Monster CN,,0,0,0,,好恐怖哦
Dialogue: 0,0:18:21.94,0:18:22.75,Default JP,,0,0,0,,すみません
Dialogue: 0,0:18:21.94,0:18:22.75,Default CN,,0,0,0,,抱歉
Dialogue: 0,0:18:22.91,0:18:23.70,Default JP,,0,0,0,,いいのよ
Dialogue: 0,0:18:22.91,0:18:23.70,Default CN,,0,0,0,,没关系
Dialogue: 0,0:18:24.71,0:18:28.22,Default JP,,0,0,0,,みんなを食べようなんて...よほど  腹が減ってるナッツ
Dialogue: 0,0:18:24.71,0:18:28.22,Default CN,,0,0,0,,说要吃了我们...是因为饿坏了吧
Dialogue: 0,0:18:28.48,0:18:30.42,Default JP,,0,0,0,,その気持ち  分かるナツ
Dialogue: 0,0:18:28.48,0:18:30.42,Default CN,,0,0,0,,我能理解他的心情
Dialogue: 0,0:18:30.60,0:18:32.54,Default JP,,0,0,0,,同情してる場合じゃないココ！
Dialogue: 0,0:18:30.60,0:18:32.54,Default CN,,0,0,0,,现在不是同情他的时候！
Dialogue: 0,0:18:54.31,0:18:55.20,Default JP,,0,0,0,,ドリーム！
Dialogue: 0,0:18:54.31,0:18:55.20,Default CN,,0,0,0,,Dream！
Dialogue: 0,0:19:01.37,0:19:02.62,Default JP,,0,0,0,,大丈夫ですか？
Dialogue: 0,0:19:01.37,0:19:02.62,Default CN,,0,0,0,,没事吧？
Dialogue: 0,0:19:02.94,0:19:04.33,Default JP,,0,0,0,,うん  ありがとう
Dialogue: 0,0:19:02.94,0:19:04.33,Default CN,,0,0,0,,嗯 谢谢你
Dialogue: 0,0:19:06.28,0:19:07.77,Monster JP,,0,0,0,,コワイナー
Dialogue: 0,0:19:06.28,0:19:07.77,Monster CN,,0,0,0,,好恐怖哦
Dialogue: 0,0:19:09.34,0:19:11.62,Default JP,,0,0,0,,全部  お前らのせいだ...！
Dialogue: 0,0:19:09.34,0:19:11.62,Default CN,,0,0,0,,全都是你们的错...！
Dialogue: 0,0:19:11.84,0:19:12.50,Default JP,,0,0,0,,はあ？
Dialogue: 0,0:19:11.84,0:19:12.50,Default CN,,0,0,0,,哈？
Dialogue: 0,0:19:12.86,0:19:14.30,Default JP,,0,0,0,,お前らさえいなけりゃ
Dialogue: 0,0:19:12.86,0:19:14.30,Default CN,,0,0,0,,要是没有你们...
Dialogue: 0,0:19:14.30,0:19:17.45,Default JP,,0,0,0,,今ごろ...バイト代もらって...
Dialogue: 0,0:19:14.30,0:19:17.45,Default CN,,0,0,0,,我现在...也就能拿到工资...
Dialogue: 0,0:19:17.82,0:19:19.93,Default JP,,0,0,0,,腹を減らすこともなかった！
Dialogue: 0,0:19:17.82,0:19:19.93,Default CN,,0,0,0,,就不会饿肚子了！
Dialogue: 0,0:19:20.34,0:19:21.94,Monster JP,,0,0,0,,コワイナー
Dialogue: 0,0:19:20.34,0:19:21.94,Monster CN,,0,0,0,,好恐怖哦
Dialogue: 0,0:19:23.34,0:19:25.06,Default JP,,0,0,0,,許さねえ！プリキュア！
Dialogue: 0,0:19:23.34,0:19:25.06,Default CN,,0,0,0,,我绝不原谅你们！Precure！
Dialogue: 0,0:19:25.48,0:19:27.42,Monster JP,,0,0,0,,コワイナー
Dialogue: 0,0:19:25.48,0:19:27.42,Monster CN,,0,0,0,,好恐怖哦
Dialogue: 0,0:19:29.17,0:19:30.08,Monster JP,,0,0,0,,コワイナー
Dialogue: 0,0:19:29.17,0:19:30.08,Monster CN,,0,0,0,,好恐怖哦
Dialogue: 0,0:19:31.77,0:19:34.17,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&H99D83A&}Precure Mint Protection
Dialogue: 0,0:19:37.48,0:19:40.38,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&H51E2F4&}Precure Lemonade Flash
Dialogue: 0,0:19:44.94,0:19:46.17,Default JP,,0,0,0,,くそ
Dialogue: 0,0:19:44.94,0:19:46.17,Default CN,,0,0,0,,可恶
Dialogue: 0,0:19:46.71,0:19:49.10,Default JP,,0,0,0,,俺が  こんなに  ひもじいのも  全部...
Dialogue: 0,0:19:46.71,0:19:49.10,Default CN,,0,0,0,,我会饿成这样 全都是...
Dialogue: 0,0:19:49.60,0:19:51.22,Default JP,,0,0,0,,お前らが悪いんだ！
Dialogue: 0,0:19:49.60,0:19:51.22,Default CN,,0,0,0,,全都是你们的错啊！
Dialogue: 0,0:19:51.97,0:19:55.38,Default JP,,0,0,0,,さっきから  聞いてれば  何でもかんでも  ひとのせいにして
Dialogue: 0,0:19:51.97,0:19:55.38,Default CN,,0,0,0,,你从刚才开始就一直在怪别人不好
Dialogue: 0,0:19:56.08,0:19:58.09,Default JP,,0,0,0,,お腹を空かせた  ナッツはね
Dialogue: 0,0:19:56.08,0:19:58.09,Default CN,,0,0,0,,纳兹也一样饿肚子
Dialogue: 0,0:19:58.25,0:20:02.51,Default JP,,0,0,0,,自分で  チラシ配って  一生懸命  頑張ってるんだから！
Dialogue: 0,0:19:58.25,0:20:02.51,Default CN,,0,0,0,,但他还是很努力地去发传单啊！
Dialogue: 0,0:20:03.34,0:20:04.94,Default JP,,0,0,0,,それがどうした？！
Dialogue: 0,0:20:03.34,0:20:04.94,Default CN,,0,0,0,,那又怎么样？！
Dialogue: 0,0:20:05.52,0:20:07.22,Monster JP,,0,0,0,,コワイナー
Dialogue: 0,0:20:05.52,0:20:07.22,Monster CN,,0,0,0,,好恐怖哦
Dialogue: 0,0:20:09.80,0:20:13.30,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&HEF8B36&}Precure Aqua Stream
Dialogue: 0,0:20:16.02,0:20:18.90,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&H5159F4&}Precure Rouge Fire
Dialogue: 0,0:20:26.14,0:20:27.28,Default JP,,0,0,0,,あんた...
Dialogue: 0,0:20:26.14,0:20:27.28,Default CN,,0,0,0,,你真是...
Dialogue: 0,0:20:27.85,0:20:29.62,Default JP,,0,0,0,,すんごくカッコ悪い！
Dialogue: 0,0:20:27.85,0:20:29.62,Default CN,,0,0,0,,让人讨厌！
Dialogue: 0,0:20:35.97,0:20:39.10,Bank-Eng,,0,0,0,,{\fad(200,200)\blur10\bord5\3c&HCB50F4&}Precure Dream Attack
Dialogue: 0,0:20:40.00,0:20:40.72,Default JP,,0,0,0,,ヤバッ！
Dialogue: 0,0:20:40.00,0:20:40.72,Default CN,,0,0,0,,不好！
Dialogue: 0,0:20:41.45,0:20:43.77,Default JP,,0,0,0,,おのれ  プリキュアめ！
Dialogue: 0,0:20:41.45,0:20:43.77,Default CN,,0,0,0,,该死的Precure！
Dialogue: 0,0:20:44.22,0:20:45.37,Default JP,,0,0,0,,この怨み...
Dialogue: 0,0:20:44.22,0:20:45.37,Default CN,,0,0,0,,这笔账...
Dialogue: 0,0:20:45.37,0:20:47.42,Alternate JP,,0,0,0,,次こそ  晴らしてやるからな！
Dialogue: 0,0:20:45.37,0:20:47.42,Alternate CN,,0,0,0,,我下次一定会跟你们讨回来！
Dialogue: 0,0:20:53.40,0:20:54.60,Alternate JP,,0,0,0,,お願いします
Dialogue: 0,0:20:53.40,0:20:54.60,Alternate CN,,0,0,0,,请看一看
Dialogue: 0,0:20:55.35,0:20:56.70,Default JP,,0,0,0,,よろしくお願いします
Dialogue: 0,0:20:55.35,0:20:56.70,Default CN,,0,0,0,,请多关照
Dialogue: 0,0:20:54.88,0:20:55.94,Alternate JP,,0,0,0,,どうぞ
Dialogue: 0,0:20:54.88,0:20:55.94,Alternate CN,,0,0,0,,请看一看
Dialogue: 0,0:20:55.94,0:20:56.80,Alternate JP,,0,0,0,,お願いします
Dialogue: 0,0:20:55.94,0:20:56.80,Alternate CN,,0,0,0,,请看一看
Dialogue: 0,0:20:56.90,0:20:58.19,Default JP,,0,0,0,,よろしくお願いします
Dialogue: 0,0:20:56.90,0:20:58.19,Default CN,,0,0,0,,请多关照
Dialogue: 0,0:20:58.37,0:20:59.00,Default JP,,0,0,0,,どうぞ
Dialogue: 0,0:20:58.37,0:20:59.00,Default CN,,0,0,0,,请看一看
Dialogue: 0,0:20:59.01,0:21:00.94,Default JP,,0,0,0,,アクセサリーのお店です...
Dialogue: 0,0:20:59.01,0:21:00.94,Default CN,,0,0,0,,饰 饰品店...
Dialogue: 0,0:21:01.16,0:21:02.60,Default JP,,0,0,0,,よろしくお願いします...
Dialogue: 0,0:21:01.16,0:21:02.60,Default CN,,0,0,0,,请看一看...
Dialogue: 0,0:21:08.46,0:21:09.33,Default JP,,0,0,0,,あっ！
Dialogue: 0,0:21:08.46,0:21:09.33,Default CN,,0,0,0,,啊！
Dialogue: 0,0:21:10.80,0:21:12.31,Default JP,,0,0,0,,あなた様！
Dialogue: 0,0:21:10.80,0:21:12.31,Default CN,,0,0,0,,是您！
Dialogue: 0,0:21:14.88,0:21:18.42,Default JP,,0,0,0,,{\fad(100,0)}ナゾの超イケメン  正体分かる！
Dialogue: 0,0:21:14.88,0:21:18.42,Default CN,,0,0,0,,{\fad(100,0)}谜之超级型男的真面目揭晓啦！
Dialogue: 0,0:21:19.06,0:21:20.62,Default JP,,0,0,0,,その名も  ナッツ様！
Dialogue: 0,0:21:19.06,0:21:20.62,Default CN,,0,0,0,,他的名字是夏！
Dialogue: 0,0:21:18.90,0:21:23.70,TopSign,,0,0,0,,{\move(480,290,590,240)\fn黑体\i0\c&H000000&\3c&HFFFFFF&\bord6\be3}谜之美男子的真实身份揭晓！！
Dialogue: 0,0:21:18.90,0:21:23.70,TopSign,,0,0,0,,{\move(1124,570,1080,420)\fn黑体\i0\c&H000000&\3c&HFFFFFF&\bord6\be3}他的名字叫夏！！
Dialogue: 0,0:21:20.62,0:21:23.76,Default JP,,0,0,0,,アクセサリーショップ  「ナッツハウス」の店長｣！
Dialogue: 0,0:21:20.62,0:21:23.76,Default CN,,0,0,0,,是饰品店“Nuts House”的店长！
Dialogue: 0,0:21:19.06,0:21:23.76,PS,,0,0,0,,{\fs45}夏：是纳兹变成人形时的化名（日语里的发音和本名“Nuts”一致）
Dialogue: 0,0:21:24.66,0:21:25.80,Default JP,,0,0,0,,ナッツ...
Dialogue: 0,0:21:24.66,0:21:25.80,Default CN,,0,0,0,,夏...
Dialogue: 0,0:21:26.24,0:21:28.06,Default JP,,0,0,0,,また  ナッツかよ...
Dialogue: 0,0:21:26.24,0:21:28.06,Default CN,,0,0,0,,又是纳兹啊...
Dialogue: 0,0:21:30.94,0:21:32.28,Default JP,,0,0,0,,ありがとうございます
Dialogue: 0,0:21:30.94,0:21:32.28,Default CN,,0,0,0,,谢谢惠顾
Dialogue: 0,0:21:33.41,0:21:34.82,Default JP,,0,0,0,,ちょっと...みんな...
Dialogue: 0,0:21:33.41,0:21:34.82,Default CN,,0,0,0,,呃...各位...
Dialogue: 0,0:21:34.82,0:21:36.27,Default JP,,0,0,0,,押さないで
Dialogue: 0,0:21:34.82,0:21:36.27,Default CN,,0,0,0,,不要挤啊
Dialogue: 0,0:21:36.54,0:21:38.23,Default JP,,0,0,0,,夢原さん  夏木さん
Dialogue: 0,0:21:36.54,0:21:38.23,Default CN,,0,0,0,,梦原同学 夏木同学
Dialogue: 0,0:21:38.85,0:21:39.74,Default JP,,0,0,0,,増子さん
Dialogue: 0,0:21:38.85,0:21:39.74,Default CN,,0,0,0,,增子同学
Dialogue: 0,0:21:40.28,0:21:43.08,Default JP,,0,0,0,,ありがとう  お店を取り上げてくれたんだね！
Dialogue: 0,0:21:40.28,0:21:43.08,Default CN,,0,0,0,,你愿意给这家店打广告了呀 谢谢你！
Dialogue: 0,0:21:43.25,0:21:45.31,Default JP,,0,0,0,,何言ってるの？スクープ記事よ
Dialogue: 0,0:21:43.25,0:21:45.31,Default CN,,0,0,0,,你在说什么呢？这可是独家新闻啊
Dialogue: 0,0:21:45.45,0:21:46.42,Default JP,,0,0,0,,スクープ？
Dialogue: 0,0:21:45.45,0:21:46.42,Default CN,,0,0,0,,独家新闻？
Dialogue: 0,0:21:47.00,0:21:50.68,Default JP,,0,0,0,,あれこそが  サンクルミエール通信に  相応しい
Dialogue: 0,0:21:47.00,0:21:50.68,Default CN,,0,0,0,,这才是值得《桑克鲁米埃尔通信》报道的东西嘛
Dialogue: 0,0:21:50.88,0:21:53.18,Default JP,,0,0,0,,「ジャーナリズム」よ  分かった？
Dialogue: 0,0:21:50.88,0:21:53.18,Default CN,,0,0,0,,毕竟我可是“记者”啊 懂了吗？
Dialogue: 0,0:21:54.05,0:21:56.00,Default JP,,0,0,0,,自分の趣味だけだろう...
Dialogue: 0,0:21:54.05,0:21:56.00,Default CN,,0,0,0,,你明明就是在夹带私货嘛...
Dialogue: 0,0:21:56.60,0:21:59.42,Default JP,,0,0,0,,押さないで  アクセサリーは  いっぱいありますよ
Dialogue: 0,0:21:56.60,0:21:59.42,Default CN,,0,0,0,,请不要挤 饰品还有很多——
Dialogue: 0,0:21:59.65,0:22:01.57,Default JP,,0,0,0,,そんなに  慌てなくても  大丈夫よ
Dialogue: 0,0:21:59.65,0:22:01.57,Default CN,,0,0,0,,大家不要急——
Dialogue: 0,0:22:03.00,0:22:04.42,Default JP,,0,0,0,,ありがとうございました！
Dialogue: 0,0:22:03.00,0:22:04.42,Default CN,,0,0,0,,谢谢惠顾！
Dialogue: 0,0:23:43.02,0:23:45.24,Default JP,,0,0,0,,のぞみ  そんなに落ち込むことないよ
Dialogue: 0,0:23:43.02,0:23:45.24,Default CN,,0,0,0,,望 别那么失落嘛
Dialogue: 0,0:23:45.34,0:23:46.14,Default JP,,0,0,0,,もう  いいの
Dialogue: 0,0:23:45.34,0:23:46.14,Default CN,,0,0,0,,算了吧
Dialogue: 0,0:23:46.40,0:23:48.96,Default JP,,0,0,0,,あたし 勉強も  運動も  ダメダメなんだから
Dialogue: 0,0:23:46.40,0:23:48.96,Default CN,,0,0,0,,反正我就是成绩又差 运动又菜
Dialogue: 0,0:23:49.12,0:23:52.04,Default JP,,0,0,0,,昔から  そうだもん  いつもみんなに置いてけぼり...
Dialogue: 0,0:23:49.12,0:23:52.04,Default CN,,0,0,0,,从以前开始 就一直都跟不上大家...
Dialogue: 0,0:23:52.04,0:23:53.77,Default JP,,0,0,0,,のぞみは  ステキな女の子だよ
Dialogue: 0,0:23:52.04,0:23:53.77,Default CN,,0,0,0,,望 你是个很优秀的女孩呀
Dialogue: 0,0:23:54.14,0:23:57.36,Default JP,,0,0,0,,あせらず  少しずつ  可能性を膨らませていけばいいんだ
Dialogue: 0,0:23:54.14,0:23:57.36,Default CN,,0,0,0,,别心急 一点点地开拓你自己将来的可能性吧
Dialogue: 0,0:23:57.85,0:24:00.82,Default JP,,0,0,0,,あの気球みたいに  私も飛べるかな？
Dialogue: 0,0:23:57.85,0:24:00.82,Default CN,,0,0,0,,我也能像那个热气球一样 飞起来吗？
Dialogue: 0,0:24:00.82,0:24:02.46,Default JP,,0,0,0,,ああ  必ず
Dialogue: 0,0:24:00.82,0:24:02.46,Default CN,,0,0,0,,嗯 一定能的
Dialogue: 0,0:24:03.10,0:24:04.72,Default JP,,0,0,0,,Yes！プリキュア5
Dialogue: 0,0:24:03.10,0:24:04.72,Default CN,,0,0,0,,下一集 Yes！Precure5
Dialogue: 0,0:24:05.08,0:24:07.02,Default CN,,0,0,35,,望和可可的热气球
Dialogue: 0,0:24:07.32,0:24:08.70,Default JP,,0,0,0,,見て  見て  見てね！
Dialogue: 0,0:24:07.32,0:24:08.70,Default CN,,0,0,0,,要看要看要看哦！
Comment: 0,0:00:00.00,0:00:00.00,Default CN,,0,0,0,,OP
Dialogue: 0,0:00:48.01,0:00:51.27,OP＆ED,,0,0,0,,1. 2. 3. 4 Precure（5!）
Dialogue: 0,0:00:53.62,0:00:53.97,Alternate OP＆ED,,0,0,0,,Yes！
Dialogue: 0,0:00:51.27,0:00:53.57,OP＆ED,,0,0,0,,Pretty cu·cu·cu·cure
Dialogue: 0,0:00:56.42,0:00:56.68,Alternate OP＆ED,,0,0,0,,Yes！
Dialogue: 0,0:00:53.68,0:00:56.42,OP＆ED,,0,0,0,,Everybody Yes, fight！
Dialogue: 0,0:00:56.57,0:00:59.10,OP＆ED,,0,0,0,,心跳不已  开怀欢笑
Dialogue: 0,0:00:59.27,0:01:01.66,OP＆ED,,0,0,0,,Smile go go！
Dialogue: 0,0:01:01.77,0:01:02.59,OP＆ED,,0,0,35,,Precure~！
Dialogue: 0,0:01:04.49,0:01:06.40,OP＆ED,,0,0,35,,Yes！P·re·cu·re·5！
Dialogue: 0,0:01:07.53,0:01:10.90,OP＆ED,,0,0,0,,长大后想做什么？
Dialogue: 0,0:01:10.42,0:01:13.14,Alternate OP＆ED,,0,0,0,,想·做·想做·什么？
Dialogue: 0,0:01:13.16,0:01:15.92,OP＆ED,,0,0,0,,想亲手尝试的事有很多！
Dialogue: 0,0:01:15.92,0:01:18.12,Alternate OP＆ED,,0,0,0,,很・多・都・想・做！
Dialogue: 0,0:01:18.43,0:01:23.14,OP＆ED,,0,0,0,,哭鼻子是不能解决问题的
Dialogue: 0,0:01:23.35,0:01:27.32,OP＆ED,,0,0,0,,用心中的橡皮拭去眼泪吧
Dialogue: 0,0:01:32.08,0:01:32.51,Alternate OP＆ED,,0,0,0,,Go！
Dialogue: 0,0:01:28.90,0:01:32.12,OP＆ED,,0,0,0,,Metamorphose！
Dialogue: 0,0:01:32.26,0:01:36.71,OP＆ED,,0,0,0,,为梦想而生
Dialogue: 0,0:01:35.51,0:01:35.85,Alternate OP＆ED,,0,0,0,,One！
Dialogue: 0,0:01:36.25,0:01:36.57,Alternate OP＆ED,,0,0,0,,Two！
Dialogue: 0,0:01:36.94,0:01:37.76,Alternate OP＆ED,,0,0,0,,Three！Four！Five！
Dialogue: 0,0:01:36.94,0:01:42.09,OP＆ED,,0,0,0,,飞翔吧 努力的女孩
Dialogue: 0,0:01:41.11,0:01:41.45,Alternate OP＆ED,,0,0,0,,Five！
Dialogue: 0,0:01:41.68,0:01:42.08,Alternate OP＆ED,,0,0,0,,Four！
Dialogue: 0,0:01:42.48,0:01:43.31,Alternate OP＆ED,,0,0,0,,Three！Two！One！
Dialogue: 0,0:01:43.37,0:01:47.82,OP＆ED,,0,0,0,,未来不是只论成败
Dialogue: 0,0:01:48.17,0:01:51.25,OP＆ED,,0,0,0,,描绘自己的明天吧
Dialogue: 0,0:01:52.82,0:01:53.20,Alternate OP＆ED,,0,0,0,,Go！
Dialogue: 0,0:01:54.02,0:01:54.45,Alternate OP＆ED,,0,0,0,,GoGo！
Dialogue: 0,0:01:56.14,0:01:57.08,Alternate OP＆ED,,0,0,0,,Go Go Go Go！Yes！
Dialogue: 0,0:01:51.50,0:01:56.00,OP＆ED,,0,0,0,,转危为机 坚强地变身！
Dialogue: 0,0:01:59.71,0:02:00.05,Alternate OP＆ED,,0,0,0,,Yes！
Dialogue: 0,0:01:57.04,0:01:59.79,OP＆ED,,0,0,0,,Pretty cu·cu·cu·cure
Dialogue: 0,0:02:02.34,0:02:02.68,Alternate OP＆ED,,0,0,0,,Yes！
Dialogue: 0,0:01:59.79,0:02:02.30,OP＆ED,,0,0,0,,Everybody Yes, Huslte！
Dialogue: 0,0:02:02.42,0:02:05.04,OP＆ED,,0,0,0,,心跳不已  喜笑颜开
Dialogue: 0,0:02:05.09,0:02:07.63,OP＆ED,,0,0,0,,Smile go go！
Dialogue: 0,0:02:07.77,0:02:08.25,Alternate OP＆ED,,0,0,0,,Go！
Dialogue: 0,0:02:09.02,0:02:09.48,Alternate OP＆ED,,0,0,0,,Yes！
Dialogue: 0,0:02:07.67,0:02:12.98,OP＆ED,,0,0,0,,1. 2. 3. 4 Precure（5!）
Comment: 0,0:00:00.00,0:00:00.00,Default CN,,0,0,0,,ED
Dialogue: 0,0:22:13.84,0:22:16.84,OP＆ED,,0,0,0,,想要做梦 想要恋爱
Dialogue: 0,0:22:16.84,0:22:19.56,OP＆ED,,0,0,0,,想做很多事情
Dialogue: 0,0:22:19.85,0:22:22.44,OP＆ED,,0,0,0,,微笑就是咒語
Dialogue: 0,0:22:22.44,0:22:26.17,OP＆ED,,0,0,0,,Pre pre precure·Five☆
Dialogue: 0,0:22:26.79,0:22:28.61,OP＆ED,,0,0,0,,Yeah~！
Dialogue: 0,0:22:36.19,0:22:39.10,OP＆ED,,0,0,0,,像椰子和果仁那般
Dialogue: 0,0:22:39.10,0:22:41.05,OP＆ED,,0,0,0,,柔軟甜美的吻
Dialogue: 0,0:22:42.24,0:22:45.06,OP＆ED,,0,0,0,,沉醉其中时
Dialogue: 0,0:22:45.06,0:22:47.30,OP＆ED,,0,0,0,,闹钟响了起来
Dialogue: 0,0:22:48.37,0:22:50.39,OP＆ED,,0,0,0,,得把窗帘打开
Dialogue: 0,0:22:50.88,0:22:53.39,OP＆ED,,0,0,0,,去寻找梦的续集
Dialogue: 0,0:22:53.92,0:22:57.03,OP＆ED,,0,0,0,,希望那灿烂的阳光
Dialogue: 0,0:22:57.03,0:22:59.27,OP＆ED,,0,0,0,,不要把我的心溶化
Dialogue: 0,0:22:59.88,0:23:00.59,OP＆ED,,0,0,0,,Oh～！
Dialogue: 0,0:23:00.59,0:23:06.36,OP＆ED,,0,0,0,,太阳公公的表情多么开朗
Dialogue: 0,0:23:06.60,0:23:12.36,OP＆ED,,0,0,0,,为何可以笑得这么开怀!?
Dialogue: 0,0:23:12.56,0:23:18.21,OP＆ED,,0,0,0,,其实我的心情也是同样明亮的 color
Dialogue: 0,0:23:18.21,0:23:23.25,OP＆ED,,0,0,0,,闪闪发亮吧 My True Love！
Dialogue: 0,0:23:23.25,0:23:28.20,OP＆ED,,0,0,0,,想要做梦 想要恋爱
Dialogue: 0,0:23:28.26,0:23:31.04,OP＆ED,,0,0,0,,想做很多事情
Dialogue: 0,0:23:31.18,0:23:33.44,OP＆ED,,0,0,0,,微笑就是咒语
Dialogue: 0,0:23:33.67,0:23:35.15,OP＆ED,,0,0,0,,可爱！
Dialogue: 0,0:23:35.15,0:23:36.69,OP＆ED,,0,0,0,,最棒！
Dialogue: 0,0:23:36.69,0:23:40.01,OP＆ED,,0,0,0,,Pre pre precure·Five☆
